generator client {
  provider = "prisma-client-js"
}

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { USER FOUNDER ADMIN }
enum MembershipRole { OWNER ADMIN MEMBER }
enum PlanId { starter_monthly starter_annual growth_monthly growth_annual agency_monthly agency_annual founding_lifetime }
enum SubscriptionStatus { ACTIVE PAST_DUE PAYMENT_FAILED CANCELLED EXPIRED SUSPENDED LIFETIME }
enum AuditStatus { QUEUED RUNNING COMPLETED FAILED }
enum JobStatus { QUEUED ACQUIRING_PAGE RENDERING_DESKTOP RENDERING_MOBILE EXTRACTING RULE_ANALYSIS VISUAL_ANALYSIS EVIDENCE_MAPPING FINDING_GENERATION PRIORITIZATION AI_QA REPORT_GENERATION COMPLETED FAILED }
enum EvidenceType { TEXT DOM METADATA STRUCTURED_DATA SCREENSHOT VISUAL LINK USER_PROVIDED SYSTEM_DETECTED }
enum Severity { HIGH MEDIUM LOW }
enum Confidence { HIGH MEDIUM LOW }
enum Effort { LOW MEDIUM HIGH }
enum FindingPriority { FIX_NOW FIX_NEXT FIX_LATER }
enum FindingStatus { OPEN IN_PROGRESS COMPLETED RECHECK_REQUIRED VERIFIED STILL_DETECTED UNABLE_TO_VERIFY }
enum RecheckResult { RESOLVED IMPROVED STILL_DETECTED UNABLE_TO_VERIFY }

model User {
 id String @id @default(cuid())
 email String @unique
 name String?
 passwordHash String?
 role UserRole @default(USER)
 emailVerifiedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 memberships Membership[]
 audits Audit[]
 subscriptions Subscription[]
 payments Payment[]
 usageEvents UsageEvent[]
 sessions Session[]
 passwordResetTokens PasswordResetToken[]
 notifications Notification[]
 entitlements Entitlement[]
 usageBalances UsageBalance[]
}
model Session { id String @id @default(cuid()) userId String tokenHash String @unique expiresAt DateTime createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt]) }
model PasswordResetToken { id String @id @default(cuid()) userId String tokenHash String @unique expiresAt DateTime usedAt DateTime? user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt]) }
model Organization { id String @id @default(cuid()) name String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt memberships Membership[] projects Project[] usageEvents UsageEvent[] }
model Membership { id String @id @default(cuid()) userId String organizationId String role MembershipRole @default(MEMBER) user User @relation(fields:[userId],references:[id],onDelete:Cascade) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) @@unique([userId,organizationId]) @@index([organizationId]) }
model Project { id String @id @default(cuid()) organizationId String name String createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) stores Store[] audits Audit[] @@index([organizationId]) }
model Store { id String @id @default(cuid()) projectId String name String url String createdAt DateTime @default(now()) project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) audits Audit[] @@index([projectId]) }
model Audit { id String @id @default(cuid()) userId String projectId String storeId String? url String engineVersion String status AuditStatus @default(QUEUED) category String? startedAt DateTime? completedAt DateTime? errorCode String? errorMessage String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id]) project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) store Store? @relation(fields:[storeId],references:[id],onDelete:SetNull) evidence Evidence[] findings Finding[] usageEvents UsageEvent[] screenshots Screenshot[] jobs AuditJob[] pages Page[] rechecks Recheck[] @@index([userId,createdAt]) @@index([projectId,createdAt]) }
model AuditJob { id String @id @default(cuid()) auditId String status JobStatus @default(QUEUED) attempt Int @default(0) availableAt DateTime @default(now()) startedAt DateTime? completedAt DateTime? errorCode String? errorMessage String? correlationId String @unique createdAt DateTime @default(now()) audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade) @@index([status,availableAt]) @@index([auditId]) }
model Page { id String @id @default(cuid()) auditId String url String statusCode Int? title String? canonical String? metaDescription String? visibleText String? domHtml String? createdAt DateTime @default(now()) audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade) snapshots PageSnapshot[] @@index([auditId]) }
model PageSnapshot { id String @id @default(cuid()) pageId String viewport String screenshotUrl String? createdAt DateTime @default(now()) page Page @relation(fields:[pageId],references:[id],onDelete:Cascade) }
model Screenshot { id String @id @default(cuid()) auditId String viewport String kind String storageUrl String? mimeType String @default("image/png") createdAt DateTime @default(now()) audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade) @@index([auditId]) }
model Evidence { id String @id @default(cuid()) auditId String type EvidenceType source String location String? content String confidence Confidence createdAt DateTime @default(now()) audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade) findingLinks FindingEvidence[] @@index([auditId]) }
model Finding { id String @id @default(cuid()) auditId String title String severity Severity confidence Confidence effort Effort priority FindingPriority buyerQuestion String? observation String hypothesis String? whyItMatters String recommendation String implementationSteps String copySuggestion String? status FindingStatus @default(OPEN) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade) evidence FindingEvidence[] @@index([auditId,priority]) }
model FindingEvidence { findingId String evidenceId String finding Finding @relation(fields:[findingId],references:[id],onDelete:Cascade) evidence Evidence @relation(fields:[evidenceId],references:[id],onDelete:Cascade) @@id([findingId,evidenceId]) }
model Recheck { id String @id @default(cuid()) auditId String previousAuditId String? beforeJson Json afterJson Json result RecheckResult engineVersion String createdAt DateTime @default(now()) audit Audit @relation(fields:[auditId],references:[id],onDelete:Cascade) }
model Plan { id PlanId @id name String monthlyUnits Int lifetime Boolean @default(false) createdAt DateTime @default(now()) subscriptions Subscription[] paymentLinks PaymentLink[] }
model PaymentLink { id String @id planId PlanId provider String billingInterval String amount Decimal @db.Decimal(12,2) currency String paymentUrl String active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt plan Plan @relation(fields:[planId],references:[id]) @@unique([planId,provider,billingInterval]) }
model Payment { id String @id @default(cuid()) userId String provider String providerReference String @unique amount Decimal @db.Decimal(12,2) currency String status String planId PlanId? metadata Json? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) @@index([userId,createdAt]) }
model Subscription { id String @id userId String planId PlanId status SubscriptionStatus provider String? providerReference String? startedAt DateTime @default(now()) expiresAt DateTime? cancelledAt DateTime? user User @relation(fields:[userId],references:[id]) plan Plan @relation(fields:[planId],references:[id]) @@index([userId,status]) }
model Entitlement { id String @id @default(cuid()) userId String feature String source String active Boolean @default(true) expiresAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([userId,feature]) @@index([userId,active]) }
model UsageBalance { id String @id @default(cuid()) userId String periodStart DateTime periodEnd DateTime includedUnits Decimal @db.Decimal(10,3) consumedUnits Decimal @default(0) @db.Decimal(10,3) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([userId,periodStart]) }
model UsageEvent { id String @id @default(cuid()) userId String organizationId String? auditId String? operation String units Decimal @db.Decimal(10,3) provider String? model String? estimatedCost Decimal? @db.Decimal(12,6) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) organization Organization? @relation(fields:[organizationId],references:[id],onDelete:SetNull) audit Audit? @relation(fields:[auditId],references:[id],onDelete:SetNull) @@index([userId,createdAt]) @@index([auditId]) }
model WebhookEvent { id String @id @default(cuid()) provider String providerEventId String payload Json processedAt DateTime? createdAt DateTime @default(now()) @@unique([provider,providerEventId]) }
model Notification { id String @id @default(cuid()) userId String type String title String body String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,createdAt]) }
