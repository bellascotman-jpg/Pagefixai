generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { USER FOUNDER ADMIN }
enum MembershipRole { OWNER ADMIN MEMBER }
enum PlanId { starter_monthly starter_annual growth_monthly growth_annual agency_monthly agency_annual founding_lifetime }
enum SubscriptionStatus { ACTIVE PAST_DUE PAYMENT_FAILED CANCELLED EXPIRED SUSPENDED LIFETIME }
enum AuditStatus { QUEUED RUNNING COMPLETED FAILED }
enum EvidenceType { TEXT DOM METADATA STRUCTURED_DATA SCREENSHOT VISUAL LINK USER_PROVIDED SYSTEM_DETECTED }
enum Severity { HIGH MEDIUM LOW }
enum Confidence { HIGH MEDIUM LOW }
enum Effort { LOW MEDIUM HIGH }
enum FindingPriority { FIX_NOW FIX_NEXT FIX_LATER }
enum FindingStatus { OPEN IN_PROGRESS COMPLETED RECHECK_REQUIRED VERIFIED STILL_DETECTED UNABLE_TO_VERIFY }

data model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  audits Audit[]
  subscriptions Subscription[]
  payments Payment[]
  usageEvents UsageEvent[]
}

data model Organization {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  projects Project[]
  usageEvents UsageEvent[]
}

data model Membership {
  id String @id @default(cuid())
  userId String
  organizationId String
  role MembershipRole @default(MEMBER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([userId, organizationId])
  @@index([organizationId])
}

data model Project {
  id String @id @default(cuid())
  organizationId String
  name String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stores Store[]
  audits Audit[]
  @@index([organizationId])
}

data model Store {
  id String @id @default(cuid())
  projectId String
  name String
  url String
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audits Audit[]
}

data model Audit {
  id String @id @default(cuid())
  userId String
  projectId String
  storeId String?
  url String
  engineVersion String
  status AuditStatus @default(QUEUED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  evidence Evidence[]
  findings Finding[]
  usageEvents UsageEvent[]
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

data model Evidence {
  id String @id @default(cuid())
  auditId String
  type EvidenceType
  source String
  location String?
  content String
  confidence Confidence
  createdAt DateTime @default(now())
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  findingLinks FindingEvidence[]
  @@index([auditId])
}

data model Finding {
  id String @id @default(cuid())
  auditId String
  title String
  severity Severity
  confidence Confidence
  effort Effort
  priority FindingPriority
  buyerQuestion String?
  observation String
  hypothesis String?
  whyItMatters String
  recommendation String
  implementationSteps String
  copySuggestion String?
  status FindingStatus @default(OPEN)
  createdAt DateTime @default(now())
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  evidence FindingEvidence[]
  @@index([auditId, priority])
}

data model FindingEvidence {
  findingId String
  evidenceId String
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  @@id([findingId, evidenceId])
}

data model Plan {
  id PlanId @id
  name String
  monthlyUnits Int
  lifetime Boolean @default(false)
  createdAt DateTime @default(now())
  subscriptions Subscription[]
  paymentLinks PaymentLink[]
}

data model PaymentLink {
  id String @id @default(cuid())
  planId PlanId
  provider String
  billingInterval String
  amount Decimal @db.Decimal(12, 2)
  currency String
  paymentUrl String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan Plan @relation(fields: [planId], references: [id])
  @@index([planId, active])
}

data model Payment {
  id String @id @default(cuid())
  userId String
  provider String
  providerReference String @unique
  amount Decimal @db.Decimal(12, 2)
  currency String
  status String
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}

data model Subscription {
  id String @id @default(cuid())
  userId String
  planId PlanId
  status SubscriptionStatus
  provider String?
  providerReference String?
  startedAt DateTime @default(now())
  expiresAt DateTime?
  cancelledAt DateTime?
  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
  @@index([userId, status])
}

data model UsageEvent {
  id String @id @default(cuid())
  userId String
  organizationId String?
  auditId String?
  operation String
  units Decimal @db.Decimal(10, 3)
  provider String?
  model String?
  estimatedCost Decimal? @db.Decimal(12, 6)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  audit Audit? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([auditId])
}
